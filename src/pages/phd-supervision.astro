---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/lib/data';

const themes = [
  'Work–nonwork boundary (segmentation, integration, conflict)',
  'Assessment centres (rater variance, dimensions, scoring)',
  'Wellbeing at work (engagement, burnout, rumination, embitterment)',
  'Remote and hybrid work (wellbeing, recovery, segmentation)',
  'Psychometrics of AI-generated ratings (reliability across prompts/models, dimensionality, bias, criterion validity)',
  'Methodological work (diary studies, multilevel modelling, Bayesian approaches)',
];

const notThemes = [
  'Pure qualitative work; I am not the right supervisor for narrative or interpretivist projects.',
  'Topics that require extensive lab or neuro-imaging methods; I do not run a lab.',
  'Anything in HRM that is purely strategic, with no empirical or psychological component.',
];

const fundingPaths = [
  {
    title: 'ESRC studentships (SENSS DTP)',
    note: 'The ESRC-funded South and East Network for Social Sciences Doctoral Training Partnership (SENSS DTP) supports funded PhD studentships across eight partner universities, including UEA, in work and organisational psychology and related social sciences.',
    href: 'https://www.senss.ac.uk/',
  },
  {
    title: 'Commonwealth Scholarships',
    note: 'For applicants from eligible Commonwealth countries.',
    href: 'https://cscuk.fcdo.gov.uk',
  },
];

/* CFA diagram geometry: six observed variables loading onto one latent factor */
const cfaTopics = [
  'Work\u2013nonwork boundaries',
  'Assessment centres',
  'Wellbeing at work',
  'Remote & hybrid work',
  'AI ratings psychometrics',
  'Diary & multilevel methods',
];
const CFA = (() => {
  const boxW = 178, boxH = 34, gap = 60;
  const boxes = cfaTopics.map((label, i) => ({
    label,
    x: 10,
    y: 12 + i * gap,
    cx: 10 + boxW / 2,
    cy: 12 + i * gap + boxH / 2,
  }));
  // latent factor
  const ex = 520, ey = 187, rx = 108, ry = 66;
  // connector endpoints fanned along the left rim of the ellipse
  const angles = [-35, -21, -7, 7, 21, 35].map((a) => (a * Math.PI) / 180);
  const links = boxes.map((b, i) => {
    const sx = b.x + boxW;
    const sy = b.cy;
    const tx = ex - rx * Math.cos(angles[i]);
    const ty = ey + ry * Math.sin(angles[i]);
    const dx = tx - sx, dy = ty - sy;
    const len = Math.hypot(dx, dy);
    const ux = dx / len, uy = dy / len;
    const px = -uy, py = ux;
    const bx = tx - ux * 9, by = ty - uy * 9;
    return {
      sx, sy, tx, ty,
      chevron: `M ${(bx + px * 3.5).toFixed(1)} ${(by + py * 3.5).toFixed(1)} L ${tx.toFixed(1)} ${ty.toFixed(1)} L ${(bx - px * 3.5).toFixed(1)} ${(by - py * 3.5).toFixed(1)}`,
    };
  });
  return { boxW, boxH, boxes, ex, ey, rx, ry, links };
})();
---

<BaseLayout
  title="PhD Supervision"
  description={`PhD supervision at the University of East Anglia with ${site.name}. Topics, expectations, and how to apply.`}
>
  <section class="phd section">
    <div class="container-prose">
      <header class="phd__head fade-in">
        <p class="eyebrow">PhD supervision</p>
        <h1 class="phd__title">If you are thinking about doing a PhD with me.</h1>

        <div class="phd__status phd__status--open">
          <svg class="phd__status-write" viewBox="0 0 28 36" width="26" height="34" fill="none" aria-hidden="true">
            <!-- single-stroke letters, written then erased in turn: p → h → d → repeat -->
            <path class="phd-write__letter" d="M8 10V32 M8 13 C17 11 20 17 17 22 C14 27 8 24 8 19"
              stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" pathLength="100"></path>
            <path class="phd-write__letter" d="M8 8V30 M8 20 C10 15 18 15 18 21 L18 30"
              stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" pathLength="100"></path>
            <path class="phd-write__letter" d="M18 13 C10 11 7 17 10 22 C13 27 18 24 18 19 M18 8V30"
              stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" pathLength="100"></path>
          </svg>
          <div>
            <p class="phd__status-label">I am always seeking motivated PhD students. If you have a great idea and you are interested in doing a PhD read below.</p>
            <p class="phd__status-note">{site.phdStatusNote}</p>
          </div>
        </div>
      </header>

      <p class="lead">
        I supervise PhD students within the <a href="/research/">Employment Systems and
        Institutions</a> research group at Norwich Business School. The work I supervise tends
        to be quantitative, organisational-psychology in flavour, and tightly scoped around a
        question that can be answered with a designed study.
      </p>

      <!-- Live CFA diagram: observed topics loading onto one latent factor -->
      <figure class="phd__cfa reveal" data-phd-cfa>
        <svg viewBox="0 0 680 420" data-draw-root data-stagger="130" aria-hidden="true">
          {/* observed variables */}
          {CFA.boxes.map((b) => (
            <>
              <rect
                x={b.x}
                y={b.y}
                width={CFA.boxW}
                height={CFA.boxH}
                fill="none"
                stroke="var(--motif-stroke)"
                stroke-width="1"
                rx="2"
                data-draw
              />
              <text
                x={b.cx}
                y={b.cy + 3.5}
                text-anchor="middle"
                class="phd-cfa__box-label"
                data-fade
              >
                {b.label}
              </text>
            </>
          ))}
          {/* loadings: draw one at a time */}
          {CFA.links.map((l) => (
            <>
              <line x1={l.sx} y1={l.sy} x2={l.tx} y2={l.ty} stroke="var(--motif-stroke)" stroke-width="1" data-draw />
              <path d={l.chevron} fill="none" stroke="var(--motif-stroke)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" data-draw />
            </>
          ))}
          {/* the latent factor */}
          <ellipse
            class="phd-cfa__latent"
            cx={CFA.ex}
            cy={CFA.ey}
            rx={CFA.rx}
            ry={CFA.ry}
            fill="none"
            stroke="var(--colour-accent)"
            stroke-width="1.5"
            data-draw
          />
          <text x={CFA.ex} y={CFA.ey + 8} text-anchor="middle" class="phd-cfa__eta" data-fade>η</text>
        </svg>
        <figcaption class="phd-cfa__caption">
          things I'll happily supervise <span aria-hidden="true">(η)</span>
        </figcaption>
      </figure>

      <h2 class="phd__h2">Topics I can supervise.</h2>
      <p>
        My research is concentrated in a few areas, and the strongest PhD applications tend to
        sit squarely in one of them. The following are all in scope, provided the project is
        well-defined and the candidate has a credible plan for the data and methods:
      </p>
      <ul class="phd__themes">
        {themes.map((t) => <li>{t}</li>)}
      </ul>

      <h2 class="phd__h2">Topics I am not the right supervisor for.</h2>
      <p>
        Being clear about this saves everyone's time:
      </p>
      <ul class="phd__themes phd__themes--no">
        {notThemes.map((t) => <li>{t}</li>)}
      </ul>

      <h2 class="phd__h2">What I'm looking for in an application.</h2>
      <p>
        I do not need a fully formed research design (the PhD is for figuring that out), but
        I do want to see a clear research question, a sense of which methods you would use to
        answer it, and a brief argument for why this question matters. A short initial email
        is the right place to start; please attach a CV and a one-page sketch of the project
        you have in mind.
      </p>
      <p>
        The strongest candidates I have supervised have usually had prior research experience:
        a research assistant post, an MSc with a dissertation, a publication or working paper
        in progress. None of this is a hard requirement, but it does help.
      </p>

      <h2 class="phd__h2">Funding.</h2>
      <p>
        PhD funding in the UK is highly competitive. Some suggested routes that you may want to explore are:
      </p>
      <ul class="phd__funding">
        {fundingPaths.map((f) => (
          <li>
            <h3 class="phd__funding-title">
              <a href={f.href} rel="noopener" target="_blank">{f.title}</a>
            </h3>
            <p>{f.note}</p>
          </li>
        ))}
      </ul>
      <p>
        I am also open to candidates with their own funding (employer-sponsored, government
        scholarship from your home country, charitable trust, etc.). If you have a specific
        funding route in mind, mention it in your initial email.
      </p>

      <h2 class="phd__h2" id="how-to-apply">How to apply.</h2>
      <p>
        The email enquiry is the first step, not the application itself. Once we have agreed
        that a project is a good fit, you will need to submit a formal application through
        UEA's postgraduate research admissions portal. The official pages below set out the
        process, deadlines, and what you will need to prepare:
      </p>
      <ul class="phd__funding">
        <li>
          <h3 class="phd__funding-title">
            <a href="https://www.uea.ac.uk/apply/postgraduate/research" rel="noopener" target="_blank">Apply for a postgraduate research degree (UEA)</a>
          </h3>
          <p>The starting point for the formal application, with links to begin or resume an application.</p>
        </li>
        <li>
          <h3 class="phd__funding-title">
            <a href="https://www.uea.ac.uk/research/research-with-us/postgraduate-research/latest-phds-and-research-studentships/how-to-apply" rel="noopener" target="_blank">How to apply: UEA guidance</a>
          </h3>
          <p>What the application involves: documents, proposal structure, references, and timing.</p>
        </li>
      </ul>

      <h2 class="phd__h2">How to get in touch.</h2>
      <p>
        Email me at <a href={`mailto:${site.email}`}>{site.email}</a>. Attach a CV and a
        research proposal or a one-page project sketch. I read everything that comes in,
        though I cannot always reply within a week, particularly around teaching and editorial
        deadlines. For the formal UEA application and funding deadlines, see the
        <a href="#how-to-apply">How to apply</a> section above.
      </p>
    </div>
  </section>
</BaseLayout>


<style>
  .phd__head {
    margin-bottom: var(--space-7);
  }
  .phd__title {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 300;
    line-height: var(--leading-tight);
    color: var(--colour-ink);
    margin-bottom: var(--space-5);
    letter-spacing: -0.025em;
  }

  .phd__status {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-5);
    border: 1px solid var(--colour-accent);
    background: var(--colour-accent-soft);
    border-radius: var(--radius-3);
  }
  /* Writes p, erases, writes h, erases, writes d, repeats.
     One shared 9s cycle; each letter phase-shifted by a third via negative delay. */
  .phd__status-write {
    color: var(--colour-accent);
    flex-shrink: 0;
    margin-top: 0.1em;
    overflow: visible;
  }
  .phd-write__letter {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  @media (prefers-reduced-motion: no-preference) {
    .phd-write__letter {
      animation: phd-write-cycle 9s linear infinite;
    }
    .phd-write__letter:nth-of-type(2) { animation-delay: -6s; }
    .phd-write__letter:nth-of-type(3) { animation-delay: -3s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .phd__status-write { display: none; }  /* ponytail: static fallback skipped, label carries the message */
  }
  @keyframes phd-write-cycle {
    0%, 2%   { stroke-dashoffset: 100; }  /* hidden */
    14%      { stroke-dashoffset: 0; }    /* written */
    30%      { stroke-dashoffset: 0; }    /* hold */
    40%, 100% { stroke-dashoffset: -100; } /* erased */
  }
  .phd__status-label {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--colour-accent);
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
  }
  .phd__status-note {
    margin-top: 0.4em;
    font-size: 0.9375rem;
    color: var(--colour-ink);
    line-height: var(--leading-loose);
  }

  .lead {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--colour-ink);
    margin-bottom: var(--space-6);
  }

  /* Live CFA diagram */
  .phd__cfa {
    margin: var(--space-6) 0 var(--space-8);
  }
  .phd__cfa svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .phd-cfa__box-label {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--colour-ink);
    letter-spacing: 0.02em;
  }
  .phd-cfa__eta {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 34px;
    fill: var(--colour-accent);
  }
  /* the latent factor pulses gently once assembled */
  @media (prefers-reduced-motion: no-preference) {
    .phd-cfa__latent {
      transform-box: fill-box;
      transform-origin: center;
      animation: phd-latent-pulse 2.6s var(--ease-in-out) 2.6s infinite;
    }
    @keyframes phd-latent-pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50%      { transform: scale(1.035); opacity: 0.82; }
    }
  }
  .phd-cfa__caption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--colour-ink-faint);
  }

  .phd__h2 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--colour-ink);
    margin-top: var(--space-7);
    margin-bottom: var(--space-4);
    letter-spacing: -0.015em;
  }

  p {
    font-size: 1.0625rem;
    line-height: var(--leading-loose);
    color: var(--colour-ink);
    margin-bottom: var(--space-4);
  }

  .phd__themes {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0;
  }
  .phd__themes li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border-top: 1px solid var(--colour-rule);
    font-size: 1rem;
    line-height: var(--leading-snug);
    color: var(--colour-ink);
  }
  .phd__themes li:last-child { border-bottom: 1px solid var(--colour-rule); }
  .phd__themes li::before {
    content: '◦';
    position: absolute;
    left: 0;
    top: 0.95em;
    color: var(--colour-accent);
    font-weight: 500;
  }
  .phd__themes--no li::before {
    content: '·';
    color: var(--colour-ink-faint);
  }

  .phd__funding {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0;
  }
  .phd__funding li {
    padding: var(--space-4) 0;
    border-top: 1px solid var(--colour-rule);
  }
  .phd__funding li:last-child { border-bottom: 1px solid var(--colour-rule); }
  .phd__funding-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--colour-ink);
    margin-bottom: 0.4em;
  }
  .phd__funding-title a {
    color: var(--colour-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--colour-rule);
  }
  .phd__funding-title a:hover {
    color: var(--colour-accent);
    border-color: var(--colour-accent);
  }
</style>
