          </g>
          <g data-fade>
            <ellipse cx="415" cy="155" rx="4.5" ry="6.0" transform="rotate(-25 415 155)" fill="var(--colour-accent-soft)" stroke="var(--colour-accent)" stroke-opacity="0.55" stroke-width="0.8"/>
            <path d="M 413.5 160.0 Q 415 156.0 416.5 160.0" fill="none" stroke="var(--colour-ink-faint)" stroke-width="0.7"/>
          </g>
          <g data-fade>
            <ellipse cx="243" cy="262" rx="4.0" ry="5.4" transform="rotate(15 243 262)" fill="var(--colour-accent-soft)" stroke="var(--colour-accent)" stroke-opacity="0.55" stroke-width="0.8"/>
