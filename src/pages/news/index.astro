            <circle cx="80.0" cy="325.4" r="0.8" fill="var(--colour-accent)"/>
            <circle cx="83.3" cy="322.0" r="0.8" fill="var(--colour-accent)"/>
            <circle cx="87.6" cy="324.1" r="0.8" fill="var(--colour-accent)"/>
          </g>
          <g data-fade>
            <ellipse cx="316.5" cy="204.3" rx="4.5" ry="3.5" transform="rotate(-6 316.5 204.3)" fill="var(--colour-accent-soft)" stroke="var(--colour-accent)" stroke-opacity="0.55" stroke-width="0.8"/>
            <ellipse cx="312.7" cy="211.0" rx="4.5" ry="3.5" transform="rotate(66 312.7 211.0)" fill="var(--colour-accent-soft)" stroke="var(--colour-accent)" stroke-opacity="0.55" stroke-width="0.8"/>
            <ellipse cx="305.1" cy="209.4" rx="4.5" ry="3.5" transform="rotate(138 305.1 209.4)" fill="var(--colour-accent-soft)" stroke="var(--colour-accent)" stroke-opacity="0.55" stroke-width="0.8"/>
            <ellipse cx="304.3" cy="201.7" rx="4.5" ry="3.5" transform="rotate(210 304.3 201.7)" fill="var(--colour-accent-soft)" stroke="var(--colour-accent)" stroke-opacity="0.55" stroke-width="0.8"/>
            <ellipse cx="311.4" cy="198.6" rx="4.5" ry="3.5" transform="rotate(282 311.4 198.6)" fill="var(--colour-accent-soft)" stroke="var(--colour-accent)" stroke-opacity="0.55" stroke-width="0.8"/>
            <circle cx="310" cy="205" r="1.8" fill="var(--colour-accent)" fill-opacity="0.85"/>
            <circle cx="313.1" cy="206.8" r="0.7" fill="var(--colour-accent)"/>
            <circle cx="309.3" cy="208.5" r="0.7" fill="var(--colour-accent)"/>
            <circle cx="306.4" cy="205.4" r="0.7" fill="var(--colour-accent)"/>
            <circle cx="308.5" cy="201.7" r="0.7" fill="var(--colour-accent)"/>
