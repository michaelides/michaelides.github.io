---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '~/lib/data';
import { formatDate } from '~/lib/format';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const typeLabel: Record<string, string> = {
  talk: 'Talk',
  podcast: 'Podcast',
  press: 'Press',
  reflection: 'Reflection',
  award: 'Award',
  publication: 'Publication',
  note: 'Note',
};
---

<BaseLayout
  title="News"
  description={`News, talks, press, awards, and brief reflections from ${site.name}.`}
>
  <section class="news section">
    <div class="container-wide news__top">
      <header class="news__head fade-in">
        <p class="eyebrow">News</p>
        <h1 class="news__title">Recent notes.</h1>
        <p class="news__lede">
          A short log of what I have been doing: talks, podcasts, press, awards, occasional
          reflections. Subscribe via <a href="/rss.xml">RSS</a> if you would like updates
          without checking the page.
        </p>
      </header>

      <div class="news__branch-col">
      <!-- Sumi-e blossom branch: the branch brushes itself in, blossoms follow -->
