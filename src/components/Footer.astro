---
import { site } from '~/lib/data';
import { formatDate } from '~/lib/format';
import Logo from '~/components/Logo.astro';

const year = new Date().getFullYear();
const lastUpdated = site.lastUpdated;
---

<footer class="site-footer">
  <!-- Ink-wash gradient into the footer -->
  <div class="site-footer__wash" aria-hidden="true"></div>

  <div class="container-wide site-footer__inner">
    <div class="site-footer__col site-footer__col--main">
      <p class="site-footer__name">
        <span class="site-footer__enso" aria-hidden="true">
          <Logo size={26} class="site-footer__logo" />
        </span>
        {site.name}
      </p>
      <p class="site-footer__role">{site.role} · {site.affiliation}</p>
      <p class="site-footer__tagline">{site.tagline}</p>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Elsewhere</h2>
      <ul class="site-footer__links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`https://orcid.org/${site.orcid}`} rel="noopener" target="_blank">ORCID <span class="site-footer__ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={site.scholar} rel="noopener" target="_blank">Google Scholar <span class="site-footer__ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn <span class="site-footer__ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={site.uea_profile} rel="noopener" target="_blank">UEA Profile <span class="site-footer__ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Colophon</h2>
      <p class="site-footer__meta">
        Set in <em>Newsreader</em> &amp; <em>Inter</em>.<br />
        Built with <a href="https://astro.build" rel="noopener" target="_blank">Astro<span class="visually-hidden"> (opens in a new tab)</span></a>, hosted on GitHub Pages.
      </p>
    </div>
  </div>

  <div class="container-wide site-footer__base">
    <p>© {year} {site.name}.</p>
    <p class="site-footer__updated">
      {lastUpdated && <>Last updated <time datetime={lastUpdated}>{formatDate(lastUpdated, { style: 'long' })}</time>.</>}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-10);
    position: relative;
    color: var(--colour-ink);
  }

  /* Soft ink-wash gradient bleeding down from the page */
  .site-footer__wash {
    position: absolute;
    inset: -80px 0 auto 0;
    height: 160px;
    background: linear-gradient(to bottom,
      transparent 0%,
      var(--colour-paper-deep) 78%,
      var(--colour-paper-deep) 100%);
    pointer-events: none;
    z-index: -1;
  }

  .site-footer__inner {
    background: var(--colour-paper-deep);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-7);
    padding: var(--space-8) var(--space-5) var(--space-7);
    border-top: 1px solid var(--colour-rule);
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .site-footer__col--main {
    font-family: var(--font-display);
  }

  .site-footer__name {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--colour-ink);
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .site-footer__enso {
    display: inline-flex;
    color: var(--colour-logo);
  }
  .site-footer__logo {
    display: block;
    width: 26px;
    height: 26px;
  }
  .site-footer__role {
    margin-top: 0.4em;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--colour-ink-muted);
  }
  .site-footer__tagline {
    margin-top: 0.75em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--colour-accent);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--colour-ink-muted);
    margin-bottom: var(--space-4);
  }

  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }
  .site-footer__links a {
    color: var(--colour-ink);
    text-decoration: none;
    font-size: 0.9375rem;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .site-footer__links a:hover {
    color: var(--colour-accent);
    border-color: var(--colour-accent);
  }
  .site-footer__ext {
    font-size: var(--step--2);
    color: var(--colour-ink-faint);
    margin-left: 0.2em;
  }

  .site-footer__meta {
    font-size: 0.875rem;
    line-height: var(--leading-loose);
    color: var(--colour-ink-muted);
  }
  .site-footer__meta em {
    font-style: italic;
    color: var(--colour-ink);
  }
  .site-footer__meta a {
    color: inherit;
  }
  .site-footer__meta a:hover { color: var(--colour-accent); }

  .site-footer__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-5);
    background: var(--colour-paper-deep);
    border-top: 1px solid var(--colour-rule);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--colour-ink-muted);
    letter-spacing: 0.04em;
  }

  @media (max-width: 540px) {
    .site-footer__base {
      flex-direction: column;
      gap: var(--space-2);
      align-items: flex-start;
    }
  }
</style>
